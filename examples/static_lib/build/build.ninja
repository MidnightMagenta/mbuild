# regen
rule regen
  command = /home/midnight/projects/mbuild/mbuild -C . ../Mbuild
  description = REGEN $out
  generator = 1

build build.ninja: regen /home/midnight/projects/mbuild/examples/static_lib/Mbuild /home/midnight/projects/mbuild/examples/static_lib/src/Mbuild | /home/midnight/projects/mbuild/mbuild
  pool = console

# global variables
compiler = gcc
cflags = -I../include
arflags = rcs

# pools

# rules
rule cc
  command = $compiler $cflags -MD -MF $out.d -c $in -o $out
  description = CC $in -> $out
  depfile = $out.d
  deps = gcc

rule ar
  command = ar $arflags $out $in
  description = AR $out

# edges
build src/add.c.o: cc ../src/add.c
build src/sub.c.o: cc ../src/sub.c
build src/mul.c.o: cc ../src/mul.c
build src/div.c.o: cc ../src/div.c
build libexample.a: ar src/add.c.o src/sub.c.o src/mul.c.o src/div.c.o

# defaults
default libexample.a
