# regen
rule regen
  command = /home/midnight/projects/mbuild/mbuild -C . ../Mbuild
  description = REGEN $out
  generator = 1

build build.ninja: regen /home/midnight/projects/mbuild/examples/lib_user/Mbuild /home/midnight/projects/mbuild/examples/static_lib/Mbuild /home/midnight/projects/mbuild/examples/static_lib/src/Mbuild | /home/midnight/projects/mbuild/mbuild
  pool = console

# global variables
compiler = gcc
cflags = -I../../static_lib/include
arflags = rcs
compiler = gcc
cflags = -I../include
arflags = rcs

# pools

# rules
rule cc
  command = $compiler $cflags -MD -MF $out.d -c $in -o $out
  description = CC $in -> $out
  depfile = $out.d
  deps = gcc

rule ld
  command = $compiler -o $out $in
  description = LD $in -> $out

rule cc
  command = $compiler $cflags -MD -MF $out.d -c $in -o $out
  description = CC $in -> $out
  depfile = $out.d
  deps = gcc

rule ar
  command = ar $arflags $out $in
  description = AR $out

# edges
build ../static_lib/src/add.c.o: cc ../../static_lib/src/add.c
build ../static_lib/src/sub.c.o: cc ../../static_lib/src/sub.c
build ../static_lib/src/mul.c.o: cc ../../static_lib/src/mul.c
build ../static_lib/src/div.c.o: cc ../../static_lib/src/div.c
build libexample.a: ar ../static_lib/src/add.c.o ../static_lib/src/sub.c.o ../static_lib/src/mul.c.o ../static_lib/src/div.c.o
build main.c.o: cc ../main.c
build ../libuser: ld main.c.o ../../static_lib/build/libexample.a

# defaults
default ../libuser
